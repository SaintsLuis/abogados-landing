---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Sera Immigration Law — Family, Employment & Asylum Counsel · Bilingual EN/ES",
  description = "Sera Immigration Law: bilingual U.S. immigration counsel since 1998. Family petitions, employment visas (H-1B, O-1, EB-1), asylum, deportation defense, and citizenship. Free 24-hour case review. Serving New Jersey, New York, and Philadelphia."
} = Astro.props;

const siteUrl = "https://sera-immigration.law";
const ogImage = `${siteUrl}/og-image.svg`;
---
<!doctype html>
<html lang="en" dir="ltr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="color-scheme" content="light" />
  <meta name="theme-color" content="#0a1f3d" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content="immigration lawyer, abogado de inmigración, New Jersey immigration attorney, New York immigration lawyer, Philadelphia immigration attorney, H-1B, O-1, green card, asylum, asilo, deportation defense, citizenship, Newark NJ immigration" />
  <meta name="author" content="Sera Immigration Law, PC" />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <link rel="canonical" href={`${siteUrl}/`} />
  <link rel="alternate" hreflang="en" href={`${siteUrl}/`} />
  <link rel="alternate" hreflang="es" href={`${siteUrl}/es/`} />
  <link rel="alternate" hreflang="x-default" href={`${siteUrl}/`} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Sera Immigration Law" />
  <meta property="og:title" content="Sera Immigration Law — Counsel for the next chapter" />
  <meta property="og:description" content="Bilingual U.S. immigration counsel since 1998. Serving NJ, NY & Philadelphia. Family, employment, asylum, defense, citizenship. Free 24-hour case review." />
  <meta property="og:locale" content="en_US" />
  <meta property="og:locale:alternate" content="es_US" />
  <meta property="og:url" content={`${siteUrl}/`} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Sera Immigration Law — Newark, New York, Philadelphia" />

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Sera Immigration Law" />
  <meta name="twitter:description" content="Bilingual U.S. immigration counsel since 1998. NJ · NY · Philadelphia. Free 24-hour case review." />
  <meta name="twitter:image" content={ogImage} />

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json">
    {JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LegalService",
      "name": "Sera Immigration Law, PC",
      "description": "Bilingual U.S. immigration counsel: family, employment, asylum, deportation defense, citizenship. Serving New Jersey, New York, and Philadelphia.",
      "url": siteUrl,
      "telephone": "+1-973-555-0140",
      "email": "hello@sera-immigration.law",
      "priceRange": "$$",
      "areaServed": ["US"],
      "availableLanguage": ["en", "es", "pt", "fr"],
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "1 Gateway Center, Suite 800",
        "addressLocality": "Newark",
        "addressRegion": "NJ",
        "postalCode": "07102",
        "addressCountry": "US"
      },
      "openingHoursSpecification": [{
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        "opens": "08:30",
        "closes": "18:30"
      }],
      "founder": "Camila Vargas",
      "foundingDate": "1998",
      "sameAs": []
    })}
  </script>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <slot />
</body>
</html>
