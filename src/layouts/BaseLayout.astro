  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="color-scheme" content="light" />
  <meta name="theme-color" content="#0a1f3d" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content="immigration lawyer, abogado de inmigración, H-1B, O-1, green card, asylum, asilo, deportation defense, citizenship, San Francisco immigration attorney" />
  <meta name="author" content="Sera Immigration Law, PC" />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <link rel="canonical" href="https://sera-immigration.law/" />
  <link rel="alternate" hreflang="en" href="https://sera-immigration.law/" />
  <link rel="alternate" hreflang="es" href="https://sera-immigration.law/es/" />
  <link rel="alternate" hreflang="x-default" href="https://sera-immigration.law/" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Sera Immigration Law" />
  <meta property="og:title" content="Sera Immigration Law — Counsel for the next chapter" />
  <meta property="og:description" content="Bilingual U.S. immigration counsel since 1998. Family, employment, asylum, defense, citizenship. Free 24-hour case review." />
  <meta property="og:locale" content="en_US" />
  <meta property="og:locale:alternate" content="es_US" />
  <meta property="og:url" content="https://sera-immigration.law/" />
