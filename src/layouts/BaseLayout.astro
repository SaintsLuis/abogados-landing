---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Sera Immigration Law — Family, Employment & Asylum Counsel · Bilingual EN/ES",
  description = "Sera Immigration Law: bilingual U.S. immigration counsel since 1998. Family petitions, employment visas (H-1B, O-1, EB-1), asylum, deportation defense, and citizenship. Free 24-hour case review."
} = Astro.props;
